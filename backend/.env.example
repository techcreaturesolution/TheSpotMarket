PORT=3000
INDIANAPI_BASE_URL=https://stock.indianapi.in
INDIANAPI_KEY=your_indianapi_key_here
IPO_CACHE_TTL_SECONDS=600

# Angel One SmartAPI Config (used for live Indian market data & gainers/losers)
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_angel_client_id
ANGEL_PASSWORD=your_angel_password
ANGEL_TOTP_SECRET=your_angel_totp_secret

# Google Gemini AI Config (used for secure server-side SpotAI proxy)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Configuration
ALLOWED_ORIGINS=https://thespotmarket-1.onrender.com,https://thespotmarket.com,http://localhost:3000
