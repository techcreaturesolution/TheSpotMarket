# ==============================================================================
# TheSpotMarket App Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Backend API Base URL
# - Desktop / iOS Simulator: http://127.0.0.1:3000
# - Android Emulator: http://10.0.2.2:3000
# - Physical Device: http://<YOUR_LAN_IP>:3000
BACKEND_URL=http://127.0.0.1:3000

# SpotAI Configuration
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Google AdMob Test Units
ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111
ADMOB_BANNER_IOS=ca-app-pub-3940256099942544/2934735716
